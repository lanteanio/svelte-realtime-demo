# postgres:17-alpine pinned by digest. Bump manually when pulling in
# upstream patches; the operator owns the cadence.
FROM postgres:17-alpine@sha256:5a6fcbc5d93831991d2386fa634509b3c49a1ac5ffb70c13c2322840f821d7e7

# First initialization creates only the non-superuser application/migration
# role. The Compose `migrate` service is the single schema-creation and upgrade
# path for both fresh and existing databases.
COPY scripts/init-app-role.sh /docker-entrypoint-initdb.d/00-init-app-role.sh
RUN chmod +x /docker-entrypoint-initdb.d/00-init-app-role.sh
