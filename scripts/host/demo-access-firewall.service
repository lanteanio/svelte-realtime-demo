[Unit]
Description=Demo host inbound access policy
DefaultDependencies=no
After=local-fs.target ufw.service
Before=network-pre.target ssh.socket docker.service shutdown.target
Wants=local-fs.target network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/demo-access-firewall apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
