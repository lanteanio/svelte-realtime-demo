{
	"name": "svelte-realtime-demo",
	"private": true,
	"version": "0.5.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"test": "npm run test:unit && npm run test:e2e:all",
		"test:unit": "node --test test/*.test.mjs",
		"test:e2e": "node scripts/run-local-e2e.mjs main",
		"test:e2e:isolated": "node scripts/run-local-e2e.mjs isolated",
		"test:e2e:all": "node scripts/run-local-e2e.mjs all"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.1.0",
		"daisyui": "^5.0.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.1.0",
		"undici": "^8.10.2",
		"vite": "^8.3.4",
		"ws": "^8.21.0"
	},
	"dependencies": {
		"lucide-svelte": "^0.577.0",
		"pg": "^8.16.2",
		"svelte-adapter-uws": "^0.5.11",
		"svelte-adapter-uws-extensions": "^0.5.11",
		"svelte-realtime": "^0.5.14",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
