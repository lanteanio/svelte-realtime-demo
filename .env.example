DOMAIN=svelte-realtime-demo.lantean.io
# TLS cert hot-reload toggle for the adapter. This stack renews certs by
# graceful restart (certbot + entrypoint.sh), so the adapter's in-process
# SNI-swap reload is left off. Do not set to 1 with the default
# host-networking deployment - the swap refuses external TLS handshakes there.
SSL_WATCH=0
# Postgres superuser password. Used by the postgres image for first-init +
# operator ad-hoc maintenance (`docker exec -it <container> psql -U postgres`).
# The app does NOT connect with this; see STICKYNOTES_APP_PASSWORD below.
POSTGRES_PASSWORD=change-me
# Required. The password for the non-superuser `stickynotes_app` role that
# the app uses for runtime database access. On first-init the role is
# created automatically with this password. For existing deployments
# upgrading to this version, run the one-shot migration documented in
# CHANGELOG.md to create the role manually before restarting the stack.
STICKYNOTES_APP_PASSWORD=change-me-too
# Optional. One shared pool per process; with the default four replicas this
# caps app connections at 40 and leaves PostgreSQL operational headroom.
DATABASE_POOL_MAX=10
# Optional bounded dependency waits (milliseconds).
DATABASE_CONNECT_TIMEOUT_MS=2000
REDIS_SESSION_TIMEOUT_MS=1000
READINESS_TIMEOUT_MS=2500
# Optional. When set, redis starts with --requirepass and the app's REDIS_URL
# carries the matching AUTH. When unset (default), redis runs unauthenticated
# but is bound to 127.0.0.1 only, so external clients still cannot connect.
# Recommended for any deployment beyond a single trusted host.
REDIS_PASSWORD=
# Optional. When set, /metrics requires the scraper to send a matching
# `X-Scrape-Token` header. Unset = endpoint is open (existing deployments
# that scrape without auth keep working). Recommended for any deployment
# beyond a single trusted host.
METRICS_SCRAPE_TOKEN=
# Required in production. HMAC secret used to verify inbound `/api/demos/news`
# webhook signatures. The legacy fallback was a hardcoded string checked into
# the repo, so production fail-closes at startup when this is unset. Dev still
# falls back to the static value for a zero-config fresh checkout. Generate
# with `openssl rand -hex 32`.
DEMO_NEWS_WEBHOOK_SECRET=change-me-three
# Bearer token for the /__realtime/* admin plane (introspect, DLQ inspect +
# replay, lifeline metrics). Fail-closed: when unset, every admin request is
# denied. Generate with `openssl rand -hex 32`.
ADMIN_TOKEN=
# Optional. HMAC secret for the /demos/outbound-webhooks signing pair. The dev
# fallback is acceptable because the receiving sink is our own logging route;
# set a real value in production anyway.
DEMO_OUTBOUND_WEBHOOK_SECRET=
# Optional. Secret behind the /demos/lobbies share codes. Safe dev fallback;
# a real value makes production codes unguessable across deploys.
ROOMS_CODE_SECRET=
